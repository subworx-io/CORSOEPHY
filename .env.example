# .env.example
# Kopiere diese Datei zu .env und befülle sie mit echten Werten.
# .env wird NICHT committed. Diese Datei schon.

# App
NODE_ENV=development
PORT=3000
# Die öffentliche URL der App — wird als Magic-Link-Redirect genutzt.
# Localhost für reinen Desktop-Dev. Für iPhone-Tests: aktuelle ngrok-HTTPS-URL
# eintragen (ändert sich bei jedem ngrok-Neustart) UND dieselbe URL in
# Supabase Dashboard → Auth → URL Configuration → Redirect URLs allowlisten.
VITE_APP_URL=http://localhost:3000

# HINWEIS: VITE_STORY_HOUR gibt es nicht mehr — sie wurde nie ausgelesen.
# Die Zyklus-Uhrzeit (21:00) steht an genau zwei Stellen: CYCLE_HOUR in
# src/lib/corso-day.ts und corso_day() in der DB. Beide müssen zusammenpassen.

# Pilot-Konfiguration
VITE_PILOT_CITY=Düsseldorf
VITE_PILOT_PRICE_EUR=9

# ---------------------------------------------------------------------------
# Supabase (Backend: Auth + Postgres + Storage + Cron) — Phase 0
# Projekt-URL und anon key sind client-seitig (VITE_, öffentlich — RLS schützt).
# Der service_role key ist NUR serverseitig (kein VITE_!) und umgeht RLS —
# niemals ins Frontend-Bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Management-Token für Migrationen (scripts/db-apply.mjs).
# Neu erzeugen unter https://supabase.com/dashboard/account/tokens.
# Persönliches Token — nicht teilen, nicht committen (.env ist git-ignoriert).
SBP=

# ---------------------------------------------------------------------------
# Push-Notifications (PWA) — Phase 1
# VAPID-Schlüsselpaar für Web Push (RFC 8292). Einmalig erzeugen mit:
#   node scripts/make-vapid-keys.mjs
# Der öffentliche Schlüssel geht ins Frontend-Bundle (VITE_), der private
# ausschließlich in die Supabase Edge Function (Dashboard → Edge Functions →
# Secrets). Der private Schlüssel darf NIE ein VITE_-Präfix bekommen.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt-Adresse des Absenders, vom Push-Dienst verlangt (mailto: oder https:).
VAPID_SUBJECT=mailto:hallo@corso.app

# ---------------------------------------------------------------------------
# Stripe (Abo €9/Monat) — erst zahlender Fremden-Pilot (Roadmap, nicht im MVP)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
