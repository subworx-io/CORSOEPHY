# .env.example
# Kopiere diese Datei zu .env und befülle sie mit echten Werten.
# .env wird NICHT committed. Diese Datei schon.

# App
NODE_ENV=development
PORT=3000
VITE_APP_URL=http://localhost:3000

# Stadt-Story Uhrzeit (default: 20:00)
VITE_STORY_HOUR=20

# Pilot-Konfiguration
VITE_PILOT_CITY=Düsseldorf
VITE_PILOT_PRICE_EUR=9

